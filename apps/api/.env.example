# Local development values. Replace the Warcraft Logs credentials before importing reports.
DATABASE_URL=postgresql://gpc:gpc@localhost:5432/gpc?schema=public

WARCRAFTLOGS_CLIENT_ID=replace_with_client_id
WARCRAFTLOGS_CLIENT_SECRET=replace_with_client_secret
WARCRAFTLOGS_TOKEN_URL=https://www.warcraftlogs.com/oauth/token
WARCRAFTLOGS_GRAPHQL_URL=https://www.warcraftlogs.com/api/v2/client

# Optional overrides
PORT=4000
CORS_ORIGIN=http://localhost:5173
